{
  "name": "nerf-research-console",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron .",
    "package:win": "npm run build && node desktop/package.cjs",
    "package:portable": "npm run package:win"
  },
  "build": {
    "appId": "org.nerfresearch.console",
    "productName": "NeRF Research Console",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "dir"
      ],
      "icon": "desktop/icon.ico",
      "artifactName": "NeRF-Research-Console-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@react-three/drei": "^10.7.4",
    "@react-three/fiber": "^9.3.0",
    "@tabler/icons-react": "^3.35.0",
    "framer-motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.1.2",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.179.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "~5.9.2",
    "vite": "^7.1.4"
  }
}
